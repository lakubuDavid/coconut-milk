--- Generate tsconfig.json (bare — JS with type-checking via checkJs)
function GENERATORS.tsconfig_js()
  return [[{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "checkJs": true,
    "allowJs": true
  },
  "include": ["views/**/*", "assets/**/*", "generated/**/*.d.ts", "scripts/coconut.d.ts"],
  "exclude": ["node_modules", "dist", "assets/lib"]
}
]]
end

--- Generate tsconfig.json (bare-ts)
function GENERATORS.tsconfig()
  return [[{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "checkJs": true,
    "allowJs": true
  },
  "include": ["src/**/*", "generated/**/*.d.ts", "scripts/coconut.d.ts"],
  "exclude": ["node_modules", "dist"]
}
]]
end

--- Generate coconut.d.ts (type definitions for the bridge API)
-- (coconut.d.ts and coconut.d.lua are copied from schemas/ at scaffold time)

--- Generate commands/example.lua
function GENERATORS.example_command()
  return [[--- Example command for the Coconut Milk app.
--- Demonstrates @command annotations used by the code generator.

local json = coconut.json
local fs = coconut.fs

---@command ping
---@return { message: string }
local function ping(params, ctx)
  return { message = "pong" }
end

---@command greet
---@param params { name: string }
---@return { greeting: string }
local function greet(params, ctx)
  local name = params.name or "world"
  return { greeting = "Hello, " .. name .. "!" }
end

return {
  ping = ping,
  greet = greet,
}
]]
end

--- Generate commands/example.g.js (for frontend consumption)
function GENERATORS.example_g_js()
  return [[(function () {
  'use strict';

  /**
   * Simple ping command.
   * @returns {Promise<{message: string}>}
   */
  async function ping() {
    return coconut.call("ping", {});
  }

  /**
   * Greet someone.
   * @param {{name?: string}} params
   * @returns {Promise<{greeting: string}>}
   */
  async function greet(params) {
    return coconut.call("greet", params);
  }

  window.ping = ping;
  window.greet = greet;

  if (typeof module !== 'undefined' && module.exports) {
    module.exports = { ping, greet };
  }
})();
]]
end

--- Generate README.md
function GENERATORS.readme(project_name, template, framework, pkg_manager)
  local pm = pkg_manager or "npm"
  local lines = {
    '# ' .. project_name,
    '',
    'A Coconut Milk project.',
    '',
    '## Getting Started',
    '',
  }
  if template == "vite" then
    lines[#lines + 1] = '### Dev mode (hot reload)'
    lines[#lines + 1] = ''
    lines[#lines + 1] = '```bash'
    lines[#lines + 1] = '# Terminal 1: start Vite dev server'
    lines[#lines + 1] = pm .. ' run dev'
    lines[#lines + 1] = ''
    lines[#lines + 1] = '# Terminal 2: run Coconut with env flag'
    lines[#lines + 1] = 'COCONUT_DEV=1 coconut'
    lines[#lines + 1] = '```'
    lines[#lines + 1] = ''
    lines[#lines + 1] = '### Production mode'
    lines[#lines + 1] = ''
    lines[#lines + 1] = '```bash'
    lines[#lines + 1] = pm .. ' run build'
    lines[#lines + 1] = 'coconut'
    lines[#lines + 1] = '```'
  else
    lines[#lines + 1] = '```bash'
    lines[#lines + 1] = 'coconut'
    lines[#lines + 1] = '```'
  end
  lines[#lines + 1] = ''
  lines[#lines + 1] = '## Structure'
  lines[#lines + 1] = ''
  lines[#lines + 1] = '```'
  lines[#lines + 1] = project_name .. '/'
  lines[#lines + 1] = '├── coconut.config.lua'
  lines[#lines + 1] = '├── coconut.d.lua'
  lines[#lines + 1] = '├── main.lua'
  lines[#lines + 1] = '├── tsconfig.json'
  lines[#lines + 1] = '├── scripts/'
  lines[#lines + 1] = '│   └── coconut.d.ts'
  lines[#lines + 1] = '├── commands/'
  lines[#lines + 1] = '│   ├── example.lua'
  lines[#lines + 1] = '│   └── example.g.js'
  lines[#lines + 1] = '└── views/'
  if template == "bare-ts" then
    lines[#lines + 1] = '    ├── index.html'
    lines[#lines + 1] = '    ├── style.css'
    lines[#lines + 1] = '    └── app.ts'
  elseif template == "vite" then
    lines[#lines + 1] = '    └── (Vite project files)'
  else
    lines[#lines + 1] = '    ├── index.html'
    lines[#lines + 1] = '    ├── style.css'
    lines[#lines + 1] = '    └── app.js'
  end
  lines[#lines + 1] = '```'
  lines[#lines + 1] = ''
  return table.concat(lines, "\n")
end

-- ── Scaffold functions ────────────────────────────────────────────────────

local function scaffold_bare(project_dir, project_name)
  log("Scaffolding bare project...")

  mkdir(path_join(project_dir, "commands"))
  mkdir(path_join(project_dir, "views"))
  mkdir(path_join(project_dir, "assets"))
  mkdir(path_join(project_dir, "scripts"))

  write_file(path_join(project_dir, "coconut.config.lua"),
    GENERATORS.coconut_config(project_name, "bare"))
  write_file(path_join(project_dir, "main.lua"),
    GENERATORS.main(project_name, "bare"))
  write_file(path_join(project_dir, "views/index.html"),
    GENERATORS.index_html(project_name))
  write_file(path_join(project_dir, "views/style.css"),
    GENERATORS.style_css())
  write_file(path_join(project_dir, "views/app.js"),
    GENERATORS.app_js())
  write_file(path_join(project_dir, "commands/example.lua"),
    GENERATORS.example_command())
  write_file(path_join(project_dir, "commands/example.g.js"),
    GENERATORS.example_g_js())
  write_file(path_join(project_dir, "assets/icon.svg"),
    GENERATORS.icon_svg())
  write_file(path_join(project_dir, "tsconfig.json"),
    GENERATORS.tsconfig_js())
  copy_schema(project_dir, "coconut.d.lua")
  copy_schema(project_dir, "coconut.d.ts", "scripts")
  write_file(path_join(project_dir, "README.md"),
    GENERATORS.readme(project_name, "bare"))
end

local function scaffold_bare_ts(project_dir, project_name)
  log("Scaffolding bare-ts project...")

  mkdir(path_join(project_dir, "commands"))
  mkdir(path_join(project_dir, "views"))
  mkdir(path_join(project_dir, "assets"))
  mkdir(path_join(project_dir, "src"))
  mkdir(path_join(project_dir, "scripts"))

  write_file(path_join(project_dir, "coconut.config.lua"),
    GENERATORS.coconut_config(project_name, "bare-ts"))
  write_file(path_join(project_dir, "main.lua"),
    GENERATORS.main(project_name, "bare-ts"))
  write_file(path_join(project_dir, "views/index.html"),
    GENERATORS.index_html(project_name))
  write_file(path_join(project_dir, "views/style.css"),
    GENERATORS.style_css())
  write_file(path_join(project_dir, "src/app.ts"),
    GENERATORS.app_ts())
  write_file(path_join(project_dir, "assets/icon.svg"),
    GENERATORS.icon_svg())
  write_file(path_join(project_dir, "tsconfig.json"),
    GENERATORS.tsconfig())
  write_file(path_join(project_dir, "commands/example.lua"),
    GENERATORS.example_command())
  write_file(path_join(project_dir, "commands/example.g.js"),
    GENERATORS.example_g_js())
  copy_schema(project_dir, "coconut.d.lua")
  copy_schema(project_dir, "coconut.d.ts", "scripts")
  write_file(path_join(project_dir, "README.md"),
    GENERATORS.readme(project_name, "bare-ts"))
end

local function scaffold_vite(project_dir, project_name, framework, pkg_manager)
  local pm = pkg_manager or "npm"
  log("Scaffolding vite + " .. framework .. " project...")

  -- Create Vite project in a temp location
  local tmp_cmd = io.popen("mktemp -d 2>/dev/null || echo /tmp/_coconut_vite_$$")
  local tmp_dir = tmp_cmd:read("*l")
  tmp_cmd:close()
  os.execute("rm -rf " .. tmp_dir)
  os.execute("mkdir -p " .. tmp_dir)

  local cmd
  if pm == "bun" then
    cmd = "cd '" .. tmp_dir .. "' && bunx --yes create-vite@latest . --template " .. framework .. " --no-interactive 2>&1 </dev/null"
  else
    cmd = "cd '" .. tmp_dir .. "' && npm create vite@latest . -- --template " .. framework .. " --no-interactive 2>&1 </dev/null"
  end
  log("Running: " .. pm .. " create vite . --template " .. framework)
  local ok = os.execute(cmd)
  if not ok then
    die("Failed to create Vite project. Is " .. pm .. " installed?")
  end

  -- Move Vite files into project dir (without nested subdirectory)
  ok = os.execute("cp -r '" .. tmp_dir .. "'/. '" .. project_dir .. "' 2>/dev/null")
  os.execute("rm -rf '" .. tmp_dir .. "'")

  -- Upgrade to latest Vite + framework plugin
  log("Upgrading to latest Vite...")
  if pm == "bun" then
    os.execute("cd " .. project_dir .. " && bun add vite@latest 2>&1 </dev/null")
  else
    os.execute("cd " .. project_dir .. " && npm install vite@latest 2>&1 </dev/null")
  end

  -- Update vite.config for relative base
  local vc_path = path_join(project_dir, "vite.config.js")
  local vc = io.open(vc_path, "r")
  if vc then
    local content = vc:read("*a")
    vc:close()
    -- Add base: './' after plugins line
    if not content:find("base:") then
      content = content:gsub("(plugins:%s*%[.-%])", "%1,\n  base: './'")
      write_file(vc_path, content)
    end
  end

  -- Create coconut structure
  mkdir(path_join(project_dir, "commands"))

  write_file(path_join(project_dir, "coconut.config.lua"),
    GENERATORS.coconut_config(project_name, "vite"))
  write_file(path_join(project_dir, "main.lua"),
    GENERATORS.main(project_name, "vite"))
  write_file(path_join(project_dir, "commands/example.lua"),
    GENERATORS.example_command())
  write_file(path_join(project_dir, "commands/example.g.js"),
    GENERATORS.example_g_js())

  -- Copy schema type definitions
  copy_schema(project_dir, "coconut.d.lua")
  copy_schema(project_dir, "coconut.d.ts", "scripts")

  -- Copy default icon
  write_file(path_join(project_dir, "public/icon.svg"),
    GENERATORS.icon_svg())

  write_file(path_join(project_dir, "README.md"),
    GENERATORS.readme(project_name, "vite", framework, pm))

  -- Install dependencies
  log("Installing dependencies...")
  if pm == "bun" then
    os.execute("cd " .. project_dir .. " && bun install 2>&1 </dev/null")
  else
    os.execute("cd " .. project_dir .. " && npm install 2>&1 </dev/null")
  end
end

-- ── Agent skill symlink ───────────────────────────────────────────────

--- Detect the framework SKILL.md path by looking relative to the create-coconut-app script.
local function find_skill_md()
  -- Installed skill (populated by the installer) takes precedence.
  local installed = path_join(coconut_home(), "skill", "SKILL.md")
  local it = io.open(installed, "r")
  if it then
    it:close()
    return installed
  end

  local script = arg and arg[0] or "scripts/create-coconut-app"
  local f = io.popen("readlink -f \"" .. script .. "\" 2>/dev/null || echo \"" .. script .. "\"")
  if not f then return nil end
  local real = f:read("*l")
  f:close()
  if not real then return nil end
  -- Strip filename (last component after /)
  local r = string.reverse(real)
  local without_first = r:match("/.+")
  if not without_first then return nil end
  local dir = string.reverse(without_first)
  -- Walk up to find SKILL.md (max 5 levels)
  for i = 1, 5 do
    local candidate = dir .. "/SKILL.md"
    local test = io.open(candidate, "r")
    if test then
      test:close()
      return candidate
    end
    -- Move up one directory
    local parent_r = string.reverse(dir)
    local up = parent_r:match("/.+")
    if not up then break end
    dir = string.reverse(up:sub(2))
    if dir == "" then break end
  end
  return nil
end

--- Prompt to create ./.agents/skills/coconut-milk/SKILL.md -> framework SKILL.md.
local function prompt_skill_symlink(project_dir, yes)
  local skill_src = find_skill_md()
  if not skill_src then
    -- No SKILL.md found — skip silently
    return
  end

  if yes then
    local ok = os.execute(
      "mkdir -p \"" .. project_dir .. "/.agents/skills/coconut-milk\" && " ..
      "ln -sf \"" .. skill_src .. "\" \"" ..
      project_dir .. "/.agents/skills/coconut-milk/SKILL.md\" 2>/dev/null"
    )
    if ok then
      log("Created ./.agents/skills/coconut-milk/SKILL.md")
    end
    return
  end

  io.write("Create ./.agents/skills/coconut-milk/SKILL.md symlink for Coconut skill?")
  io.write(" (y/N): ")
  io.flush()
  local ans = read_stdin()
  if ans:lower() ~= "y" then
    io.write("Skipped. Run this later to add it:\n")
    io.write("  mkdir -p ./.agents/skills/coconut-milk && ")
    io.write("ln -sf \"<path-to-SKILL.md>\" ./.agents/skills/coconut-milk/SKILL.md\n")
    return
  end

  local ok = os.execute(
    "mkdir -p \"" .. project_dir .. "/.agents/skills/coconut-milk\" && " ..
    "ln -sf \"" .. skill_src .. "\" \"" ..
    project_dir .. "/.agents/skills/coconut-milk/SKILL.md\""
  )
  if ok then
    log("Created ./.agents/skills/coconut-milk/SKILL.md")
  else
    io.write("Failed to create symlink.\n")
  end
end

-- ── Main ──────────────────────────────────────────────────────────────────

-- Vendored single-file command-line parser: mpeterv/argparse (MIT), scripts/argparse.lua.
-- Resolve this script's real directory (following symlinks, e.g. when installed to
-- ~/.local/bin) so require("argparse") works regardless of cwd or how it's invoked.
local function add_self_to_path()
  local self = arg[0] or ""
  local real = self
  local f = io.popen("readlink -f " .. self .. " 2>/dev/null")
  if f then
    local out = f:read("*a")
    f:close()
    if out and out ~= "" then real = out:gsub("\n*$", "") end
  end
  local dir = real:match("(.*)/")
  package.path = dir .. "/?.lua;" .. package.path
end
add_self_to_path()
local argparse = require("argparse")

local function build_parser()
  local parser = argparse("create-coconut-app")
  parser:description("Scaffold a new Coconut Milk project with a chosen template, framework and package manager.")
  parser:epilog([[Templates:
  bare      Coconut + raw HTML + CSS/JS
  bare-ts   bare + TypeScript + tsconfig
  vite      Coconut + Vite + framework (vanilla/react/vue/solid)

Examples:
  create-coconut-app my-app
  create-coconut-app my-app -t vite -f react -p bun -y
  create-coconut-app -t bare-ts -y]])
  parser:argument("name", "Project name"):args("?"):default("")
  parser:option("-t --template", "Template type")
        :args(1):default("bare")
        :convert(function(v) return TEMPLATES[v] and v or "bare" end)
  parser:option("-f --framework", "Framework for the vite template")
        :args(1):default("vanilla")
        :convert(function(v) return FRAMEWORKS[v] and v or "vanilla" end)
  parser:option("-p --pm", "Package manager for the vite template")
        :args(1):default("npm")
        :convert(function(v) return PACKAGE_MANAGERS[v] and v or "npm" end)
  parser:flag("-y --yes", "Skip prompts, use defaults")
  parser:flag("--offline", "Skip remote fetch; use cached/bundled schemas only")
  return parser
end

local function parse_args()
  local a = build_parser():parse()
  g_offline = g_offline or a.offline
  return {
    name = (a.name ~= "" and a.name or nil),
    template = a.template,
    framework = a.framework,
    pm = a.pm,
    yes = a.yes,
    offline = a.offline,
  }
end

-- ── CLI entry point ───────────────────────────────────────────────────────

local function main()
  local opts = parse_args()

  -- Collect project name
  local project_name = opts.name
  if not project_name or project_name == "" then
    project_name = prompt("Project name", "my-coconut-app")
  end
  if not project_name or project_name == "" then
    die("Project name is required")
  end

  -- Collect template
  local template = opts.template
  if not opts.yes then
    local templates_list = { "bare", "bare-ts", "vite" }
    template = prompt_select("Template", templates_list, template)
  end

  -- Collect package manager and framework for vite
  local pm = opts.pm
  local framework = opts.framework
  if template == "vite" and not opts.yes then
    local pm_list = { "npm", "bun" }
    pm = prompt_select("Package manager", pm_list, pm)
    local frameworks_list = { "vanilla", "react", "vue", "solid" }
    framework = prompt_select("Framework", frameworks_list, framework)
  end

  local project_dir = path_join(os.getenv("PWD") or ".", project_name)

  -- Check if directory exists
  local f = io.open(project_dir, "r")
  if f then
    f:close()
    if not opts.yes then
      io.write("Directory '" .. project_dir .. "' exists. Overwrite? [y/N]: ")
      io.flush()
      local ans = read_stdin()
      if ans:lower() ~= "y" then
        die("Aborted")
      end
    end
    os.execute("rm -rf " .. project_dir)
  end

  mkdir(project_dir)

  if template == "bare" then
    scaffold_bare(project_dir, project_name)
  elseif template == "bare-ts" then
    scaffold_bare_ts(project_dir, project_name)
  elseif template == "vite" then
    scaffold_vite(project_dir, project_name, framework, pm)
  end

  -- Prompt to add agent skill symlink
  prompt_skill_symlink(project_dir, opts.yes)

  log("Done! Created project in " .. project_dir)
  io.write("\nTo get started:\n")
  io.write("  cd " .. project_name .. "\n")
  io.write("  coconut\n")
  if template == "vite" then
    io.write("\nDev mode (with hot reload):\n")
    io.write("  # Terminal 1: " .. pm .. " run dev\n")
    io.write("  # Terminal 2: COCONUT_DEV=1 coconut " .. project_name .. "\n")
  end
  io.write("\n")
end

main()
