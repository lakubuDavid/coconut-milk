#!/usr/bin/env luajit
--- create-coconut-app - Scaffold a new Coconut Milk project.
---
--- Usage:
---   create-coconut-app [project-name] [options]
---
--- Options:
---   -t, --template <bare|bare-ts|vite>   Template type (default: bare)
---   -f, --framework <vanilla|react|vue|solid>  Framework for vite template (default: vanilla)
---   -p, --pm <npm|bun>                   Package manager for vite template (default: npm)
---   -y, --yes                            Skip prompts, use defaults
---       --offline                        Skip remote fetch, use cached/bundled schemas only
---   -h, --help                           Show this help
---
--- Templates:
---   bare      Coconut + raw HTML + CSS/JS
---   bare-ts   bare + TypeScript + tsconfig
---   vite      Coconut + Vite + framework (vanilla/react/vue/solid)
---

local TEMPLATES = { bare = true, ["bare-ts"] = true, vite = true }
local FRAMEWORKS = { vanilla = true, react = true, vue = true, solid = true }
local PACKAGE_MANAGERS = { npm = true, bun = true }

-- Global flag: set by --offline flag or COCONUT_OFFLINE env var.
-- resolve_schema() reads this to skip remote fetch.
local g_offline = os.getenv("COCONUT_OFFLINE") == "1"

-- ── Helpers ──────────────────────────────────────────────────────────────

local function die(msg)
  io.stderr:write("Error: " .. msg .. "\n")
  os.exit(1)
end

local function log(msg)
  io.write("* " .. msg .. "\n")
end

local function read_stdin()
  return io.stdin:read("*l") or ""
end

local function prompt(label, default)
  local dflt = default and (" [" .. default .. "]") or ""
  io.write(label .. dflt .. ": ")
  io.flush()
  local val = read_stdin()
  if val == "" and default then return default end
  return val
end

local function prompt_select(label, options, default)
  io.write(label .. ":\n")
  for i, opt in ipairs(options) do
    local marker = (opt == default) and " (default)" or ""
    io.write(string.format("  %d) %s%s\n", i, opt, marker))
  end
  io.write("Choice" .. (default and (" [" .. default .. "]") or "") .. ": ")
  io.flush()
  local val = read_stdin()
  if val == "" and default then return default end
  for _, opt in ipairs(options) do
    if val:lower() == opt:lower() then return opt end
  end
  local n = tonumber(val)
  if n and n >= 1 and n <= #options then return options[n] end
  return default or options[1]
end

local function shell(cmd)
  local ok = os.execute(cmd)
  if not ok then
    die("command failed: " .. cmd)
  end
end

local function mkdir(path)
  os.execute("mkdir -p " .. path)
end

local function write_file(path, content)
  local f, err = io.open(path, "w")
  if not f then die("cannot write " .. path .. ": " .. (err or "unknown")) end
  f:write(content)
  f:close()
end

local function path_join(...)
  return table.concat({ ... }, "/")
end

--- Portable mkdir -p (handles both Unix and Windows).
local function mkdir_p(dir)
  if package.config:sub(1,1) == "\\" then
    -- Windows: mkdir creates intermediate dirs by default
    os.execute("mkdir \"" .. dir .. "\" 2>NUL")
  else
    os.execute("mkdir -p \"" .. dir .. "\"")
  end
end

--- Portable rm -f.
local function rm_f(path)
  if package.config:sub(1,1) == "\\" then
    os.execute("del /f /q \"" .. path .. "\" 2>NUL")
  else
    os.execute("rm -f \"" .. path .. "\"")
  end
end

--- Detect if running on Windows.
local function is_windows()
  return package.config:sub(1,1) == "\\"
end

--- Find the coconut binary in PATH.
local function coconut_binary()
  -- Check Coconut binary location hint env var first
  local from_env = os.getenv("COCONUT_BINARY")
  if from_env and from_env ~= "" then return from_env end
  -- Try which
  local f = io.popen("which coconut 2>/dev/null || echo \"\"")
  if f then
    local path = f:read("*l")
    f:close()
    if path and path ~= "" then return path end
  end
  return "coconut"
end

-- ── Schema helpers ────────────────────────────────────────────────────────

--- Cache directory for downloaded schema files.
local function schema_cache_dir()
  local cache_home = os.getenv("COCONUT_CACHE_DIR")
  if not cache_home or cache_home == "" then
    local home
    if is_windows() then
      home = os.getenv("USERPROFILE") or os.getenv("HOME") or "~"
      cache_home = home .. "\\.cache\\coconut\\schemas"
    else
      home = os.getenv("HOME") or "~"
      cache_home = home .. "/.cache/coconut/schemas"
    end
  end
  return cache_home
end

--- Resolve a schema file path.  Returns nil + error on failure.
---
--- Resolution order:
---   1. If `offline` is true or COCONUT_OFFLINE is set, skip remote.
---   2. Check local cache (~/.cache/coconut/schemas/<filename>).
---   3. Download from GitHub raw (main branch), write to cache.
---   4. Fall back to `schemas/<filename>` relative to the script location.
--- Canonical install-home for bundled assets (schemas, agent skill, …).
--- Mirrors the installer's COCONUT_HOME (default ~/.coconut).
local function coconut_home()
  local home = os.getenv("COCONUT_HOME")
  if not home or home == "" then
    home = (os.getenv("HOME") or "~") .. "/.coconut"
  end
  return home:gsub("[/\\]$", "")  -- normalize (no trailing slash)
end

local function resolve_schema(filename, offline)
  if offline == nil then offline = g_offline end

  -- 0. Installed assets (populated by install.sh / mise-install) take
  --    precedence: this makes `create-coconut-app` fully offline-capable and
  --    independent of CWD or the script's location.
  local installed = path_join(coconut_home(), "schemas", filename)
  local inf = io.open(installed, "r")
  if inf then
    inf:close()
    return installed
  end

  -- Cache hit
  if not offline then
    local cached = path_join(schema_cache_dir(), filename)
    local f = io.open(cached, "r")
    if f then
      local content = f:read("*a")
      f:close()
      if content and #content > 0 then
        return cached
      end
    end
  end

  -- Remote fetch (unless offline)
  if not offline then
    local url = "https://raw.githubusercontent.com/lakubuDavid/coconut-milk/main/schemas/" .. filename
    local tmp = os.tmpname()
    local ok = false

    -- Try curl (macOS / Linux / modern Windows)
    ok = os.execute("curl -sSfLo \"" .. tmp .. "\" \"" .. url .. "\" 2>/dev/null")

    -- Fall back to PowerShell (older Windows without curl.exe)
    if not ok then
      ok = os.execute(
        "powershell -NoProfile -Command \"Invoke-WebRequest -Uri '" .. url ..
        "' -OutFile '" .. tmp .. "' 2>$null\" 2>/dev/null"
      )
    end

    if ok then
      local content = io.open(tmp, "r")
      if content then
        local raw = content:read("*a")
        content:close()
        if raw and #raw > 0 then
          -- Write to cache
          local cached_dir = schema_cache_dir()
          mkdir_p(cached_dir)
          local out = io.open(path_join(cached_dir, filename), "w")
          if out then
            out:write(raw)
            out:close()
          end
          rm_f(tmp)
          return path_join(cached_dir, filename)
        end
      end
      rm_f(tmp)
    end
  end

  -- Bundled fallback: resolve the script's real directory (following symlinks,
  -- and working even when invoked by bare name via PATH), then look for the file
  -- directly and inside a `schemas/` subdir at each ancestor. CWD-relative
  -- locations are also tried. This makes --offline resolve the schema files that
  -- ship in the repo's schemas/ directory without any network access.
  local search_dirs = {}
  local self_path = (arg and arg[0]) or "."
  local resolved = self_path
  -- When invoked by bare name (normal CLI usage), resolve via PATH first:
  -- readlink -f does not search PATH, so it would otherwise fail to locate the
  -- script and we'd never reach the bundled schemas/ directory.
  if not self_path:match("[/\\]") then
    local cv = io.popen("command -v " .. self_path .. " 2>/dev/null")
    if cv then
      local out = cv:read("*a")
      cv:close()
      if out and out ~= "" then resolved = out:gsub("\n*$", "") end
    end
  end
  local real = resolved
  local rf = io.popen("readlink -f " .. resolved .. " 2>/dev/null")
  if rf then
    local out = rf:read("*a")
    rf:close()
    if out and out ~= "" then real = out:gsub("\n*$", "") end
  end
  local script_dir = real:match("^(.*[/\\])") or "."
  script_dir = script_dir:gsub("[/\\]$", "")  -- strip trailing slash so the parent walk-up terminates correctly
  local dir = script_dir
  for _ = 1, 4 do
    table.insert(search_dirs, dir)
    local parent = dir:match("^(.*[/\\])")
    if not parent or parent == dir then break end
    dir = parent
  end
  table.insert(search_dirs, ".")
  table.insert(search_dirs, "schemas")
  table.insert(search_dirs, "../schemas")

  for _, dir in ipairs(search_dirs) do
    local base = dir:gsub("[/\\]$", "")  -- normalize (avoid double slashes)
    for _, cand in ipairs({ base .. "/" .. filename, base .. "/schemas/" .. filename }) do
      local f = io.open(cand, "r")
      if f then
        f:close()
        return cand
      end
    end
  end

  return nil, "could not resolve " .. filename .. " (tried " .. (#search_dirs * 2) .. " locations)"
end

--- Copy a schema file into the project directory.
local function copy_schema(project_dir, filename, subdir)
  local src_path, err = resolve_schema(filename)
  if not src_path then
    log("Warning: " .. (err or "failed to resolve " .. filename))
    return
  end

  local target = project_dir
  if subdir then target = path_join(target, subdir) end
  mkdir(target)
  target = path_join(target, filename)

  local src_f = io.open(src_path, "r")
  if not src_f then
    log("Warning: cannot read " .. src_path)
    return
  end
  local content = src_f:read("*a")
  src_f:close()

  write_file(target, content)
  log("Created " .. target)
end

-- ── File generators ──────────────────────────────────────────────────────

local GENERATORS = {}

--- Generate coconut.config.lua
function GENERATORS.coconut_config(project_name, template, framework)
  local extra = {}
  if template == "vite" then
    extra = {
      'local dev = os.getenv("COCONUT_DEV") == "1',
      "",
      'return {',
      '  initial_view = dev and "dev" or "app",',
      '  view_root = "views",',
      '  command_root = "commands",',
      '  icon = {',
      '    source = "public/icon.svg",',
      '  },',
      '  views = {',
      '    app = { kind = "file", src = "dist/index.html" },',
      '    dev = { kind = "url", src = "http://localhost:5173" },',
      '  },',
      '}',
    }
  else
    extra = {
      'return {',
      '  initial_view = "app",',
      '  view_root = "views",',
      '  command_root = "commands",',
      '  icon = {',
      '    source = "assets/icon.svg",',
      '  },',
      '  views = {',
      '    app = { kind = "file", src = "views/index.html" },',
      '  },',
      '}',
    }
  end
  return table.concat(extra, "\n") .. "\n"
end

--- Generate main.lua
function GENERATORS.main(project_name, template, framework)
  local lines = {
    '--- ' .. project_name .. ' - Coconut Milk entry point.',
    '',
    'function coconut.config(ctx)',
    '  ctx',
    '    :setWindowSize({ w = 960, h = 640 })',
    '    :setTitle("' .. project_name .. '")',
    '    :setResizable(true)',
    '    :setInitialView("app")',
    '  return ctx',
    'end',
    '',
  }
  if template == "vite" then
    lines[#lines + 1] = 'local dev = os.getenv("COCONUT_DEV") == "1"'
    lines[#lines + 1] = ''
    lines[#lines + 1] = 'function coconut.views()'
    lines[#lines + 1] = '  return {'
    lines[#lines + 1] = '    app = View.load("dist/index.html"),'
    lines[#lines + 1] = '    dev = View.url("http://localhost:5173"),'
    lines[#lines + 1] = '  }'
    lines[#lines + 1] = 'end'
  else
    lines[#lines + 1] = 'function coconut.views()'
    lines[#lines + 1] = '  return {'
    lines[#lines + 1] = '    app = View.load("views/index.html"),'
    lines[#lines + 1] = '  }'
    lines[#lines + 1] = 'end'
  end
  lines[#lines + 1] = ''
  return table.concat(lines, "\n")
end

--- Generate index.html (bare / bare-ts)
function GENERATORS.index_html(project_name)
  return [[<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>]] .. project_name .. [[</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1>]] .. project_name .. [[</h1>
  <p>Powered by Coconut Milk.</p>
  <script src="app.js"></script>
</body>
</html>
]]
end

--- Generate style.css (bare / bare-ts)
function GENERATORS.style_css()
  return [[* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: #121c1a;
  color: #e8f4f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}
h1 { font-size: 2.5rem; margin-bottom: 1rem; }
p  { font-size: 1.2rem; color: #90a9a2; }

/* Strip WebKit glossy overlay on <select> elements */
select { appearance: none; -webkit-appearance: none; -moz-appearance: none; }
]]
end

--- Generate app.js (bare)
function GENERATORS.app_js()
  return [[// Coconut Milk app.
// Use coconut.call(), coconut.emit(), coconut.on() to talk to Lua.

console.log('Hello from Coconut Milk!');
]]
end

--- Generate app.ts (bare-ts)
function GENERATORS.app_ts()
  return [[/// <reference lib="dom" />

// Coconut Milk app with TypeScript.
// Use coconut.call(), coconut.emit(), coconut.on() to talk to Lua.

const app = document.querySelector<HTMLHeadingElement>('h1')
if (app) {
  app.textContent = 'Ready'
}

console.log('Hello from Coconut Milk (TypeScript)!')
]]
end

