# Coconut Milk — component relationships (current architecture)
#
# Core message path:  JS <-> WebviewTransport <-> core::Bridge -> Dispatcher -> WorkerPool
# The dispatch pump (CFRunLoopSource + task queue) is the only bridge back to the main thread.

direction: right
vars: {
  d2-config: { layout-engine: elk }
}

app: "coconut::App\n(hub; owns webview, window,\nruntime, dispatcher, core_bridge)"

webview: "webview_t\n(WKWebView)"
window: "window::Window\nviews / navigation"

runtime: "lua::Runtime (main)\ncoconut._dispatch\ncommands registry"
ctx: "CoconutContext\n(main) — window handle,\nconfigs, bind/bind_mt"

transport: {
  label: "WebviewTransport\n(transport::Transport)\nshared_ptr"
}

bridge: {
  label: "core::Bridge\nonInbound routing\nsync executor (mt/main)"
}

dispatcher: {
  label: "core::Dispatcher\nqueue + flush\nowns WorkerPool"
}

pool: {
  label: "core::WorkerPool\nN workers, round-robin"
  w1: "Worker (Lua VM,\nctx, Commands map)"
  w2: "Worker (Lua VM,\nctx, Commands map)"
}

pump: {
  label: "dispatch (main-thread pump)\nCFRunLoopSource via\nplatform::runloop port"
  tasks: "task queue\ndispatch::post(fn)"
}

platform: "platform/* adapters\nwindow_native.h · runloop.h"

# ── ownership ─────────────────────────────────────────────
app -> webview: owns
app -> window: owns
app -> runtime: owns
app -> ctx: owns
app -> dispatcher: unique_ptr
app -> bridge: unique_ptr

dispatcher.pool <- pool: owns

# ── shared / borrowed ─────────────────────────────────────
transport -> app: borrowed App*
bridge.transport <- transport: shared_ptr
dispatcher.transport <- transport: shared_ptr
dispatcher.runtime <- runtime: raw borrow
bridge.lua <- runtime: sol state_view borrow

# ── message flow ──────────────────────────────────────────
webview -> transport: __coconut_rpc(id,name,payload)
transport -> bridge: setMessageCallback → onInbound(msg)
bridge -> dispatcher: kCall unknown cmd\nCommandCallMessage with RpcId
bridge -> transport: sync reply\nkReturn/kError envelope
dispatcher -> pool: queueMessage\n(cmd,args,RpcId)
pool -> transport: Resolve/Reject\n→ kReturn/kError envelope

pump -> dispatcher: drain() → flush()
pump.tasks -> pump: run on main\n(window/native ops)

transport -> webview: __coconut_rpc_receive(envelope)\n__coconut_dispatch_event(name,payload)
