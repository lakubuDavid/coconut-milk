title: Coconut Milk - Module Architecture {
  shape: text
  near: top-center
  style: {
    font-size: 32
    bold: true
    underline: true
  }
}

direction: right

# ----------------------------------------------------------------------
# Module overview for Coconut Milk
# Each module is a Lua plugin exposed via sol2 to the JS front-end.
# Icons use SVGL + Lucide via `icon` attribute.
# ----------------------------------------------------------------------

# Core application container
app: "coconut::App\n(hwnd, owns webview,\nwindow, runtime,\ndispatcher, core_bridge)" {
  icon: https://icons.terrastruct.com/essentials/110-window.svg
  style.fill: "#fef3c7"
  style.stroke: "#f59e0b"
  style.stroke-width: 2
}

# ----------------------------------------------------------------------
# Core C++ modules (exposed to Lua via sol2)
# ----------------------------------------------------------------------
core: {
  label: "core/ (C++ → Lua)"
  style.fill: "#ede9fe"
  style.stroke: "#7c3aed"
  style.stroke-width: 2

  bridge: "core::Bridge\nonInbound, sync executor" {
    icon: https://icons.terrastruct.com/essentials/175-link.svg
    style.fill: "#f5f3ff"
  }

  dispatcher: "core::Dispatcher\nqueue + flush\nowns WorkerPool" {
    icon: https://icons.terrastruct.com/essentials/095-share-2.svg
    style.fill: "#f5f3ff"
  }

  pool: "core::WorkerPool\nN Lua VM workers\nround-robin" {
    icon: https://icons.terrastruct.com/essentials/148-layers.svg
    style.fill: "#f5f3ff"
  }

  worker: "core::Worker\nLua VM + ctx\ncommand map" {
    icon: https://icons.terrastruct.com/essentials/051-cpu.svg
    style.fill: "#f5f3ff"
  }

  msgq: "core::MessageQueue\nfn(fn)" {
    icon: https://icons.terrastruct.com/essentials/083-message-2.svg
    style.fill: "#f5f3ff"
  }
}

# ----------------------------------------------------------------------
# Lua modules (coconut.* namespace)
# ----------------------------------------------------------------------
lua_mods: {
  label: "modules/ (Lua API)"
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  style.stroke-width: 2

  cmds: "coconut.commands\nnamed registry\nhandlers + mt_handlers" {
    icon: https://icons.terrastruct.com/essentials/139-terminal.svg
    style.fill: "#f0fdf4"
  }

  win: "coconut.window\nview events, navigation\nlifecycle" {
    icon: https://icons.terrastruct.com/essentials/110-window.svg
    style.fill: "#f0fdf4"
  }

  store: "coconut.store\npersistent KV" {
    icon: https://icons.terrastruct.com/essentials/158-database.svg
    style.fill: "#f0fdf4"
  }

  fs: "coconut.fs\nread/write/list\npath utils" {
    icon: https://icons.terrastruct.com/essentials/141-folder.svg
    style.fill: "#f0fdf4"
  }

  log: "coconut.log\nstructured logging" {
    icon: https://icons.terrastruct.com/essentials/140-file-text.svg
    style.fill: "#f0fdf4"
  }

  json: "coconut.json\nencode/decode" {
    icon: https://icons.terrastruct.com/essentials/142-file-json.svg
    style.fill: "#f0fdf4"
  }

  notify: "coconut.notify\nOS notifications" {
    icon: https://icons.terrastruct.com/essentials/077-bell.svg
    style.fill: "#f0fdf4"
  }

  openurl: "coconut.openurl\ndefault browser" {
    icon: https://icons.terrastruct.com/essentials/088-browser.svg
    style.fill: "#f0fdf4"
  }

  clip: "coconut.clipboard\nread/write text" {
    icon: https://icons.terrastruct.com/essentials/138-clipboard.svg
    style.fill: "#f0fdf4"
  }

  env: "coconut.env\nprocess env" {
    icon: https://icons.terrastruct.com/essentials/066-terminal.svg
    style.fill: "#f0fdf4"
  }

  kb: "coconut.keybind\naccelerators" {
    icon: https://icons.terrastruct.com/essentials/053-keyboard.svg
    style.fill: "#f0fdf4"
  }

  dialog: "coconut.dialog\nfile/msg/color" {
    icon: https://icons.terrastruct.com/essentials/160-message-square.svg
    style.fill: "#f0fdf4"
  }

  hot: "coconut.hotreload\nlive reload" {
    icon: https://icons.terrastruct.com/essentials/159-refresh-cw.svg
    style.fill: "#f0fdf4"
  }

  bridge_emit: "coconut.bridge_emit\nJS → Lua events" {
    icon: https://icons.terrastruct.com/essentials/095-share-2.svg
    style.fill: "#f0fdf4"
  }
}

# ----------------------------------------------------------------------
# Platform adapters (C++ per-OS)
# ----------------------------------------------------------------------
platform: {
  label: "platform/ (C++ adapters)"
  style.fill: "#fee2e2"
  style.stroke: "#dc2626"
  style.stroke-width: 2

  mac: "darwin/\nwindow, clipboard,\ndialog, lifecycle,\nnotify, open_url,\nkeyboard, permissions" {
    icon: https://icons.terrastruct.com/essentials/063-monitor.svg
    style.fill: "#fef2f2"
  }

  linux: "linux/\nwindow, clipboard,\ndialog, lifecycle,\nnotify, open_url,\nkeyboard, permissions" {
    icon: https://icons.terrastruct.com/essentials/063-monitor.svg
    style.fill: "#fef2f2"
  }

  win: "win/\nwindow, clipboard,\ndialog, lifecycle,\nnotify, open_url" {
    icon: https://icons.terrastruct.com/essentials/063-monitor.svg
    style.fill: "#fef2f2"
  }

  stub: "stub/\nfallback impls" {
    icon: https://icons.terrastruct.com/essentials/134-box.svg
    style.fill: "#fef2f2"
  }
}

# ----------------------------------------------------------------------
# Embedded assets / generators
# ----------------------------------------------------------------------
embed: {
  label: "Embedded / Generated"
  style.fill: "#f3e8ff"
  style.stroke: "#a855f7"
  style.stroke-width: 2

  embed_ts: "coconut.ts / coconut.d.ts\nTypeScript bindings" {
    icon: https://icons.terrastruct.com/essentials/384-file-typescript.svg
    style.fill: "#faf5ff"
  }

  embed_js: "coconut.js\nJS bridge runtime" {
    icon: https://icons.terrastruct.com/dev%2F/javascript.svg
    style.fill: "#faf5ff"
  }

  icon_gen: "icon_gen → default_icon.svg\nstb_image write" {
    icon: https://icons.terrastruct.com/essentials/172-image.svg
    style.fill: "#faf5ff"
  }

  gen_cli: "coconut-cli generators\n.g.lua, .g.js, .d.ts" {
    icon: https://icons.terrastruct.com/essentials/139-terminal.svg
    style.fill: "#faf5ff"
  }
}

# ----------------------------------------------------------------------
# Relationships
# ----------------------------------------------------------------------
app -> core.bridge: "owns"
app -> core.dispatcher: "owns"
app -> core.pool: "via dispatcher"
app -> lua_mods.cmds: "registers"
app -> lua_mods.win: "registers"
app -> lua_mods.store: "registers"
app -> lua_mods.fs: "registers"
app -> lua_mods.log: "registers"
app -> lua_mods.json: "registers"
app -> lua_mods.notify: "registers"
app -> lua_mods.openurl: "registers"
app -> lua_mods.clip: "registers"
app -> lua_mods.env: "registers"
app -> lua_mods.kb: "registers"
app -> lua_mods.dialog: "registers"
app -> lua_mods.hot: "registers"
app -> lua_mods.bridge_emit: "registers"

core.dispatcher -> core.pool: "owns"
core.pool -> core.worker: "spawns N"
core.worker -> core.msgq: "posts tasks"
core.msgq -> core.worker: "runs on main"
core.bridge -> core.dispatcher: "routes unknown"
core.bridge -> core.pool: "direct sync exec"

lua_mods.win -> platform.mac: "macOS"
lua_mods.win -> platform.linux: "Linux"
lua_mods.win -> platform.win: "Windows"
lua_mods.dialog -> platform.mac: "macOS"
lua_mods.dialog -> platform.linux: "Linux"
lua_mods.dialog -> platform.win: "Windows"
lua_mods.clip -> platform.mac: "macOS"
lua_mods.clip -> platform.linux: "Linux"
lua_mods.clip -> platform.win: "Windows"
lua_mods.notify -> platform.mac: "macOS"
lua_mods.notify -> platform.linux: "Linux"
lua_mods.notify -> platform.win: "Windows"
lua_mods.openurl -> platform.mac: "macOS"
lua_mods.openurl -> platform.linux: "Linux"
lua_mods.openurl -> platform.win: "Windows"

lua_mods.cmds -> embed.gen_cli: "generates"
embed.gen_cli -> lua_mods.cmds: "registers"
embed.embed_ts -> lua_mods.cmds: "wraps"
embed.embed_js -> lua_mods.bridge_emit: "calls"

# Legend
legend: {
  near: bottom-right
  shape: text
  label: "Icons: SVGL bundled + Lucide"
  style.font-size: 14
  style.italic: true
  style.fill: "#ffffff"
}