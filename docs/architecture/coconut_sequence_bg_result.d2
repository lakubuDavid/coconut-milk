# Coconut — sequence: background command result -> frontend
# Shows the cross-thread dispatch bridge (the only link between worlds today).

sequenceDiagram {
  bg: "Background thread\n(bg_thread::Context)"
  drain: "Main thread\ndispatch::drain (CFRunLoopSource)"
  bridge: "bridge"
  transport: "WebviewTransport"
  webview: "webview / JS frontend"

  bg -> bg: execute command\n(own lua / ctx / commands)
  bg ->+ drain: "CommandResult \"callId|jsonResult\"\nvia bg.outbox (dispatch::Outbox, Bg->Main)"
  drain -> drain: "CFRunLoopSource fires\n-> pop from bg.outbox"
  drain ->+ bridge: "bridge::rpcSend(rpc::Message kReturn)"
  bridge ->+ transport: "transport->send(msg)"
  transport -> webview: "webview_eval -> JS"
  transport ->- bridge
  bridge ->- drain
  drain ->- bg
}
